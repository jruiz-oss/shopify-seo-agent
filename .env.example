# Postgres (Railway injects DATABASE_URL automatically when you attach the Postgres plugin)
DATABASE_URL=postgres://user:pass@host:5432/db

# Shopify custom app: Settings > Apps and sales channels > Develop apps > Create app
# Admin API scopes: read_products, write_products, read_content, write_content,
#   read_online_store_pages, write_online_store_pages, read_online_store_navigation,
#   write_online_store_navigation (redirects), read_themes, write_themes
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2026-07

# Public storefront
SITE_URL=https://www.yourbrand.com
BRAND_NAME=Your Brand
BRAND_NOTES=Who you sell to, tone, products to never touch, competitor names to avoid, etc.

# Google Search Console: create a service account in Google Cloud, enable "Google Search Console API",
# download the JSON key, paste it here as one line. Then add the service account email as a user
# (Full or Restricted) on the property in Search Console > Settings > Users and permissions.
GSC_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# sc-domain:yourbrand.com for a domain property, or https://www.yourbrand.com/ for a URL-prefix property
GSC_PROPERTY=sc-domain:yourbrand.com

ANTHROPIC_API_KEY=sk-ant-xxx
AGENT_MODEL=claude-sonnet-5
AGENT_MAX_TURNS=40

# Behavior
COOLDOWN_DAYS=45
REJECTION_MEMORY_DAYS=90
MAX_PROPOSALS_PER_RUN=25
AGENT_CRON=0 6 * * 1
CRAWL_LIMIT=150

# Dashboard login
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
